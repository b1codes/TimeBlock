# Local .terraform directories
**/.terraform/*

# .tfstate files
*.tfstate
*.tfstate.*

# Crash log files
crash.log
crash.*.log

# Exclude override files
override.tf
override.tf.json
*_override.tf
*_override.tf.json

# Include override files you do want to add
# !override.tf

# Include lock file if you want to fix the version of provider
# !.terraform.lock.hcl

# Local vars
*.tfvars
*.tfvars.json

# .terraform.lock.hcl
.terraform.lock.hcl
