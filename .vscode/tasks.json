{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "DynamoDB: Start Container",
      "type": "shell",
      "command": "docker-compose up -d dynamodb-local",
      "problemMatcher": [],
      "presentation": {
        "reveal": "always",
        "panel": "shared"
      }
    },
    {
      "label": "DynamoDB: Initialize Table",
      "type": "shell",
      "command": "make init-db",
      "problemMatcher": [],
      "presentation": {
        "reveal": "always",
        "panel": "shared"
      }
    },
    {
      "label": "DynamoDB: Start and Initialize",
      "type": "shell",
      "command": "docker-compose up -d dynamodb-local && for i in {1..10}; do nc -z localhost 8000 && break || sleep 1; done && make init-db",
      "problemMatcher": [],
      "presentation": {
        "reveal": "always",
        "panel": "shared"
      }
    },
    {
      "label": "DynamoDB: Stop Container",
      "type": "shell",
      "command": "docker-compose down",
      "problemMatcher": [],
      "presentation": {
        "reveal": "always",
        "panel": "shared"
      }
    },
    {
      "label": "Project: Install All Dependencies",
      "type": "shell",
      "command": "make install",
      "problemMatcher": [],
      "presentation": {
        "reveal": "always",
        "panel": "shared"
      }
    },
    {
      "label": "Backend: Run Server",
      "type": "shell",
      "command": "make dev-backend",
      "isBackground": true,
      "problemMatcher": [],
      "presentation": {
        "reveal": "always",
        "panel": "shared"
      }
    },
    {
      "label": "Frontend: Start Expo Dev Server",
      "type": "shell",
      "command": "pnpm start",
      "cwd": "${workspaceFolder}/frontend",
      "isBackground": true,
      "problemMatcher": [],
      "presentation": {
        "reveal": "always",
        "panel": "shared"
      }
    },
    {
      "label": "Frontend: Start iOS Simulator",
      "type": "shell",
      "command": "pnpm ios",
      "cwd": "${workspaceFolder}/frontend",
      "isBackground": true,
      "problemMatcher": [],
      "presentation": {
        "reveal": "always",
        "panel": "shared"
      }
    },
    {
      "label": "Frontend: Start Web App",
      "type": "shell",
      "command": "pnpm web",
      "cwd": "${workspaceFolder}/frontend",
      "isBackground": true,
      "problemMatcher": [],
      "presentation": {
        "reveal": "always",
        "panel": "shared"
      }
    }
  ]
}
