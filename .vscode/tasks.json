{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "Firestore: Start Emulator",
      "type": "shell",
      "command": "make up",
      "problemMatcher": [],
      "presentation": {
        "reveal": "always",
        "panel": "shared"
      }
    },
    {
      "label": "Firestore: Seed Database",
      "type": "shell",
      "command": "make seed-db",
      "problemMatcher": [],
      "presentation": {
        "reveal": "always",
        "panel": "shared"
      }
    },
    {
      "label": "Firestore: Start and Seed",
      "type": "shell",
      "command": "make up && make seed-db",
      "problemMatcher": [],
      "presentation": {
        "reveal": "always",
        "panel": "shared"
      }
    },
    {
      "label": "Firestore: Stop Emulator",
      "type": "shell",
      "command": "docker-compose down",
      "problemMatcher": [],
      "presentation": {
        "reveal": "always",
        "panel": "shared"
      }
    },
    {
      "label": "Project: Install All Dependencies",
      "type": "shell",
      "command": "make install",
      "problemMatcher": [],
      "presentation": {
        "reveal": "always",
        "panel": "shared"
      }
    },
    {
      "label": "Backend: Run Server",
      "type": "shell",
      "command": "make dev-backend",
      "isBackground": true,
      "problemMatcher": [],
      "presentation": {
        "reveal": "always",
        "panel": "shared"
      }
    },
    {
      "label": "Frontend: Start Expo Dev Server",
      "type": "shell",
      "command": "pnpm start",
